        const output = document.getElementById('aiPriceOutput');
        if(crop.includes("Tomatoes")) output.innerText = "₹45 - ₹50 / kg";
        else if(crop.includes("Onions")) output.innerText = "₹28 - ₹32 / kg";
        else if(crop.includes("Wheat")) output.innerText = "₹24 - ₹27 / kg";
    }

